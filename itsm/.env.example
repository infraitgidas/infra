# ================================================================
# .env.example — GLPI ITSM Stack Environment
# ================================================================
# Copiar a .env y completar con valores reales (nunca commiteados):
#   cp .env.example .env
#
# Migrado a la imagen oficial glpi/glpi (2026-08-06):
# las variables GLPI_DB_* son el formato nativo de esa imagen.
# ================================================================

# --- MariaDB (credenciales reales via SOPS: secrets/glpi.yaml) ---
MYSQL_ROOT_PASSWORD=change-me-mariadb-root

# --- GLPI Database (imagen oficial glpi/glpi) ---
GLPI_DB_HOST=mariadb
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=change-me-glpi-db

# --- GLPI App ---
GLPI_TIMEZONE=America/Argentina/Buenos_Aires
GLPI_LANG=es_AR
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false

# --- Nginx (host ports) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
