# Telegram — credenciales del bot de alertas GIDAS
#
# Copiar a secrets/telegram.yaml y encriptar con SOPS:
#   sops secrets/telegram.yaml
#
# El bot de Telegram se rota con @BotFather (revoke + nuevo token).
# En producción (CT 208): exportar TELEGRAM_TOKEN y TELEGRAM_CHAT
# en el entorno del cron/systemd — NUNCA hardcodear en el código.

TELEGRAM_TOKEN: <token-del-bot-rotado>
TELEGRAM_CHAT: <chat-id-destino>
